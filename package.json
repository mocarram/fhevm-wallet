{
  "name": "fhe-cli-wallet",
  "version": "1.0.0",
  "description": "CLI wallet for managing encrypted ERC-7984 tokens using Zama's FHE technology",
  "main": "dist/index.js",
  "bin": {
    "fhe-cli-wallet": "./dist/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zama-fhe/relayer-sdk": "0.4.0-4",
    "ethers": "^6.16.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "cli-table3": "^0.6.0",
    "dotenv": "^16.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.19.30",
    "@types/inquirer": "^9.0.0",
    "eslint": "^9.0.0"
  },
  "keywords": [
    "fhe",
    "wallet",
    "ethereum",
    "zama",
    "erc-7984",
    "confidential",
    "cli"
  ],
  "license": "MIT"
}
