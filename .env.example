# RPC Endpoints
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Zama FHE Mainnet API Key (required for mainnet FHE operations)
# Get your API key from Zama to use the mainnet relayer
ZAMA_MAINNET_API_KEY=

# Etherscan API key (for transaction history sync)
ETHERSCAN_API_KEY=
